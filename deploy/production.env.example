# 复制为 deploy/production.env 后按需修改
# 使用：docker compose --env-file deploy/production.env --profile proxy up -d --build

# 已解析到服务器公网 IP 的域名；Caddy 会自动申请 HTTPS 证书
APP_DOMAIN=profinance.example.com

# 通过 HTTPS 访问时必须设为 1；直接 HTTP 访问必须设为 0
PF_SECURE_COOKIE=1

# 应用绑定和端口。由 Caddy 反向代理时 APP_BIND=127.0.0.1；
# 直接通过 IP+端口访问时改为 0.0.0.0，并关闭 Caddy。
APP_BIND=127.0.0.1
APP_PORT=8787
